# Copy to ".env" and fill in. Values prefixed PUBLIC_ are exposed to the browser.

# Web3Forms access key verified for your receiving inbox.
# Required to enable /apply and /contact forms; otherwise direct contact is shown.
# No production key is checked in.
PUBLIC_WEB3FORMS_KEY=

# (Optional) Google Analytics 4 Measurement ID.
# Create a GA4 web data stream, then set this to the value that starts with "G-".
PUBLIC_GA_MEASUREMENT_ID=

# --- Keystatic GitHub mode — REQUIRED on Vercel for the live admin (/keystatic) ---
# The deployed admin uses GitHub storage (see keystatic.config.ts). Set these in the
# Vercel project's Environment Variables (Production). Get CLIENT_ID/SECRET + the app
# slug from the GitHub App setup shown at /keystatic on first deploy. KEYSTATIC_SECRET
# is any long random string you generate (e.g. `openssl rand -hex 32`).
# The configured repository (JunOJu95/MyanMate-public) must remain Private so draft
# post files and source images are not visible outside the founding team. Grant the
# GitHub App and each editor access to that private repository.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Public contact email; changing this does NOT change Web3Forms delivery.
# Also replace PUBLIC_WEB3FORMS_KEY with a key verified for the new inbox.
PUBLIC_APPLICATION_EMAIL=junho357818@gmail.com
