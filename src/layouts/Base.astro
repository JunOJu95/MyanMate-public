---
import '../styles/global.css';
import '../styles/brand.css';
import '../styles/redesign.css';
import '../styles/learning-motion.css';
import Analytics from '@vercel/analytics/astro';
import SeoHead from '../components/SeoHead.astro';
import TopBar from '../components/TopBar.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, t, uiRevision } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  active?: string;
  canonicalPath?: string;
  image?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  articleSection?: string;
  articleAuthor?: string;
}
const {
  title,
  description,
  active,
  canonicalPath,
  image,
  ogType,
  publishedTime,
  modifiedTime,
  articleSection,
  articleAuthor,
} = Astro.props;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="expect" href="#mm-copy-ready" blocking="render" />
    <!-- Minimal fallback while a newly deployed external stylesheet reaches the edge. -->
    <style is:inline>
      /* Opt in before the first paint, including Vite's deferred dev styles. */
      @view-transition { navigation: auto; }
      @media (prefers-reduced-motion: reduce) {
        @view-transition { navigation: none; }
      }
      [data-lang] { display: none; }
      body.lang-en [data-lang='en'],
      body.lang-ko [data-lang='ko'],
      body.lang-my [data-lang='my'] { display: revert; }

      .mobile-nav {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .mobile-nav.open {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      :where(svg:not([width]):not([height])) {
        width: 28px;
        height: 18px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
    </style>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Per-language fonts (Myanmar/Korean must not break — see global.css body.lang-*) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Gothic+A1:wght@300;400;500;600;700;800&family=Noto+Sans+KR:wght@400;500;600;700;800&family=Noto+Sans+Myanmar:wght@400;500;600;700&family=Padauk:wght@400;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      image={image}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      articleSection={articleSection}
      articleAuthor={articleAuthor}
    />
    {
      gaMeasurementId && (
        <>
          <link rel="preconnect" href="https://www.googletagmanager.com" />
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`} />
          <script is:inline define:vars={{ gaMeasurementId }}>
            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            window.gtag('config', gaMeasurementId);
          </script>
        </>
      )
    }
    <Analytics />
    <slot name="head" />
  </head>
  <body class={`lang-${defaultLang}`}>
    <a class="skip-link" href="#main" data-i18n="ui.skipToContent">{t('ui.skipToContent', defaultLang)}</a>
    <TopBar active={active} />
    <main id="main" class="site-main">
      <slot />
    </main>
    <Footer />
    <script is:inline define:vars={{ uiRevision }}>
      // Reuse public copy from the preceding page; never cache form values.
      try {
        const lang = localStorage.getItem('mm-lang-v2');
        const cached = JSON.parse(sessionStorage.getItem('mm-ui-copy-v1') || 'null');
        if (cached && cached.revision === uiRevision && cached.lang === lang && ['my','ko','en'].includes(lang)) {
          document.documentElement.lang = lang;
          document.body.classList.remove('lang-my','lang-ko','lang-en');
          document.body.classList.add('lang-' + lang);
          window.__lang = lang;
          [['data-i18n',null],['data-i18n-ph','placeholder'],['data-i18n-aria','aria-label'],['data-i18n-value','value']].forEach(([source,target]) => {
            document.querySelectorAll('[' + source + ']').forEach(el => {
              const value = cached.copy[el.getAttribute(source)];
              if (typeof value !== 'string') return;
              if (target) el.setAttribute(target,value);
              else el.textContent = value;
            });
          });
          document.querySelectorAll('.lang [data-l]').forEach(el => {
            const selected = el.getAttribute('data-l') === lang;
            el.classList.toggle('on',selected);
            el.setAttribute('aria-pressed',String(selected));
          });
        }
      } catch { /* normal language runtime and default Myanmar remain available */ }
    </script>
    <!-- Release the first paint only after the cached translation has run. -->
    <span id="mm-copy-ready" hidden aria-hidden="true"></span>
    <script>
      import '../scripts/lang.ts';
      import '../scripts/analytics.ts';
      import '../scripts/motion.ts';
      import '../scripts/learning-motion.ts';
    </script>
  </body>
</html>
