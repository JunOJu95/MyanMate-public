---
import LangToggle from './LangToggle.astro';
import { t, defaultLang } from '../i18n/ui';
import { SHOW_BLOG_IN_NAV } from '../config/launch';

interface Props {
  active?: string;
}
const { active } = Astro.props;

const links = [
  { key: 'redesign.navCourses', href: '/#courses', id: 'courses' },
  { key: 'redesign.navTeachers', href: '/#teachers', id: 'teachers' },
  { key: 'redesign.navEnrollment', href: '/#enrollment', id: 'enrollment' },
  ...(SHOW_BLOG_IN_NAV ? [{ key: 'nav.blog', href: '/blog', id: 'blog' }] : []),
];
---
<header class="bar">
  <div class="bar-inner">
    <a class="logo" href="/">
      <span class="logo-mark" aria-hidden="true">M</span>
      <span class="logo-type">
        MyanMate
      </span>
    </a>
    <div class="grow"></div>
    <nav class="nav-links" aria-label={t('ui.nav.primary', defaultLang)} data-i18n-aria="ui.nav.primary">
      {links.map((l) => (
        <a class:list={['nl', { active: active === l.id }]} href={l.href} data-i18n={l.key}>{t(l.key, defaultLang)}</a>
      ))}
    </nav>
    <LangToggle />
    <a class="btn pri header-apply" href="/apply"><span data-i18n="learn.apply">{t('learn.apply', defaultLang)}</span></a>
    <button
      class="ham"
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={t('ui.menu', defaultLang)}
      data-i18n-aria="ui.menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav" aria-label={t('ui.nav.mobile', defaultLang)} data-i18n-aria="ui.nav.mobile">
    {links.map((l) => (
      <a class:list={['nl', { active: active === l.id }]} href={l.href} data-i18n={l.key}>{t(l.key, defaultLang)}</a>
    ))}
    <a class="btn pri" href="/apply"><span data-i18n="learn.apply">{t('learn.apply', defaultLang)}</span></a>
  </nav>
</header>
