---
import Base from '../layouts/Base.astro';
import BackArrow from './BackArrow.astro';
import Icon from './Icon.astro';
import InformationSection from './InformationSection.astro';
import LocalizedText from './LocalizedText.astro';
import T from './T.astro';
import Disclaimer from './Disclaimer.astro';
import MobileSocialDm from './MobileSocialDm.astro';
import SocialDmPanel from './SocialDmPanel.astro';
import type { Service } from '../data/services';
import type { ServiceInfoId } from '../data/services';
import type { ServiceContent } from '../lib/content';
import { defaultLang } from '../i18n/ui';

interface Props {
  service?: Service;
  topicId?: ServiceInfoId;
  icon?: string;
  content: ServiceContent;
  backHref?: string;
  backLabel?: {
    en: string;
    ko: string;
    my: string;
  };
}

const { service, topicId, content, backHref = '/guides', backLabel } = Astro.props;
const informationId = service?.id ?? topicId ?? 'general';
const source = `${informationId}-information`;
const sections = content.sections.map((section, index) => ({
  section,
  anchor: section.id || `information-section-${index + 1}`,
}));
const overviewSections = sections.filter(({ section }) => section.variant === 'overview');
const detailSections = sections.filter(({ section }) => section.variant !== 'overview');
---

<Base title={content.title[defaultLang]} active="guides" description={content.description[defaultLang]}>
  <div class="wrap">
    <div class:list={['detail-2col', 'detail-page', 'service-info-page', { single: !service }]}>
      <article>
        <header class="detail-hero service-detail-hero" data-reveal="page-hero">
          <BackArrow href={backHref} class="service-detail-back" />
          <LocalizedText value={content.title} tag="h1" class="lead-title" />
          <LocalizedText value={content.description} tag="p" class="t-sub" />
          <div class="information-meta-row">
            <T k="infoTopic.publicBadge" tag="span" class="pill-tag" />
            {content.lastReviewed && (
              <span class="information-reviewed">
                <T k="content.lastReviewed" />
                <time datetime={content.lastReviewed}>{content.lastReviewed}</time>
              </span>
            )}
          </div>
        </header>

        {overviewSections.map(({ section, anchor }) => (
          <InformationSection informationId={informationId} section={section} anchor={anchor} />
        ))}

        {detailSections.length > 0 && (
          <nav class="information-quick-nav" aria-labelledby="information-quick-nav-title">
            <p id="information-quick-nav-title" class="information-quick-nav-title"><T k="infoTopic.contents" /></p>
            <ol>
              {detailSections.map(({ section, anchor }, sectionIndex) => (
                <li>
                  <a href={`#${anchor}`}>
                    <span aria-hidden="true">{String(sectionIndex + 1).padStart(2, '0')}</span>
                    <LocalizedText value={section.title} />
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )}

        {detailSections.map(({ section, anchor }) => (
          <InformationSection informationId={informationId} section={section} anchor={anchor} />
        ))}

        <section class="information-editorial-note" data-reveal="section">
          <span class="information-editorial-icon" aria-hidden="true"><Icon name="shield" size={20} /></span>
          <div>
            <T k="infoTopic.disclaimer.title" tag="h2" class="card-title" />
            <T k="infoTopic.disclaimer.body" tag="p" class="t-body" />
            <T k="infoTopic.disclaimer.boundary" tag="p" class="t-cap" />
          </div>
          <a class="btn ghost" href={backHref} data-event="information-back">
            {backLabel ? <LocalizedText value={backLabel} /> : <T k="infoTopic.back" />}
          </a>
        </section>
        <Disclaimer k="content.disclaimer" class="service-info-disclaimer" />
      </article>

      {service && (
        <aside class="guide-dm-aside">
          <div class="sticky-card">
            <SocialDmPanel
              service={service.id}
              context="service"
              source={`${source}-sidebar`}
              id="dm"
            />
          </div>
        </aside>
      )}
    </div>
  </div>
  {service && <MobileSocialDm service={service.id} context="service" />}
  <script
    is:inline
    define:vars={{
      localizedPageTitles: content.title,
      localizedPageDescriptions: content.description,
      initialPageLang: defaultLang,
    }}
  >
    const initialPageTitle = localizedPageTitles[initialPageLang] || '';
    const pageTitleSuffix = document.title.startsWith(initialPageTitle)
      ? document.title.slice(initialPageTitle.length)
      : '';

    const updateLocalizedMetadata = (lang) => {
      const title = localizedPageTitles[lang] || localizedPageTitles[initialPageLang];
      const description =
        localizedPageDescriptions[lang] || localizedPageDescriptions[initialPageLang];
      if (title) {
        document.title = `${title}${pageTitleSuffix}`;
        document
          .querySelectorAll('meta[property="og:title"], meta[name="twitter:title"]')
          .forEach((meta) => meta.setAttribute('content', document.title));
      }
      if (description) {
        document
          .querySelectorAll(
            'meta[name="description"], meta[property="og:description"], meta[name="twitter:description"]'
          )
          .forEach((meta) => meta.setAttribute('content', description));
      }
    };

    document.addEventListener('mm:langchange', (event) => {
      updateLocalizedMetadata(event.detail.lang);
    });
  </script>
</Base>
