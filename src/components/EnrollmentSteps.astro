---
import T from './T.astro';
interface Props { compact?: boolean; course?: string }
const { compact = false, course } = Astro.props;
const steps = [1,2,3,4];
---
<section class:list={['mm-enrollment', { compact }]} id="enrollment">
 <div class="wrap">
  <T k={compact ? 'redesign.howStart' : 'learn.steps'} tag="h2" />
  <T k={compact ? 'redesign.speakingStepsLead' : 'redesign.stepsLead'} tag="p" class="mm-section-lead" />
  <ol class="mm-steps" data-mm-stagger>{steps.map(n => <li data-mm-reveal>
   <span class="mm-step-number" aria-hidden="true">0{n}</span>
   <T k={`learn.step${n}`} tag="h3" /><T k={`learn.step${n}Body`} tag="p" />
  </li>)}</ol>
  {!compact && <T k="redesign.noCommitment" tag="p" class="mm-enroll-note" />}
 </div>
</section>
