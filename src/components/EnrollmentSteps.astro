---
import T from './T.astro';
interface Props { compact?: boolean; course?: string }
const { compact = false } = Astro.props;
const steps = [1,2,3,4];
---
<section class:list={['mm-enrollment', { compact }]} id="enrollment" data-enrollment-flow>
 <div class="wrap mm-enrollment-layout"><div class="mm-enrollment-intro">
  <T k={compact ? 'redesign.howStart' : 'learn.steps'} tag="h2" />
  <T k={compact ? 'redesign.speakingStepsLead' : 'redesign.stepsLead'} tag="p" class="mm-section-lead" />
 </div>
  <ol class="mm-steps">{steps.map(n => <li>
   <span class="mm-step-number" aria-hidden="true">0{n}</span>
   <div><T k={`learn.step${n}`} tag="h3" /><T k={`learn.step${n}Body`} tag="p" /></div>
  </li>)}</ol>
  {!compact && <T k="redesign.noCommitment" tag="p" class="mm-enroll-note" />}
 </div>
</section>
