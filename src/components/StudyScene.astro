---
import { Image } from 'astro:assets';
import T from './T.astro';
import study from '../assets/study/online-korean-study.png';
import practice from '../assets/study/speaking-practice-desk.png';
interface Props { kind?: 'hero' | 'practice' }
const { kind = 'hero' } = Astro.props;
---
<figure class:list={['mm-study-scene', `mm-study-${kind}`]} data-mm-reveal="media" data-mm-delay={kind === 'hero' ? 100 : 0}>
 <div class="mm-study-frame">
  <Image src={kind === 'hero' ? study : practice} alt="" width={1200}
   widths={[480,800,1200]} sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) 45vw, 520px"
   format="webp" quality={82} loading={kind === 'hero' ? 'eager' : 'lazy'}
   fetchpriority={kind === 'hero' ? 'high' : 'auto'} data-mm-parallax={kind === 'hero' ? '' : undefined} />
 </div>
 <figcaption><T k="motion.studyCaption" /></figcaption>
</figure>
