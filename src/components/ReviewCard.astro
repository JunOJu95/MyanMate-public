---
import T from './T.astro';
import { languages } from '../i18n/ui';
import { reviewCourseKey, type Review } from '../lib/content';

interface Props {
  review: Review;
}
const { review } = Astro.props;
const fallbackQuote = review.my || review.ko || review.en;
---
<article class="review-card">
  <div class="review-card-top">
    <span class="review-quote-mark" aria-hidden="true">“</span>
    <T k={reviewCourseKey[review.course]} tag="span" class="review-course" />
  </div>
  <blockquote>
    {languages.map((lang) => <p data-lang={lang}>{review[lang] || fallbackQuote}</p>)}
  </blockquote>
  <div class="review-card-foot">
    {review.displayName ? <span>{review.displayName}</span> : <T k="reviews.anonymous" tag="span" />}
    <T k="reviews.student" tag="span" />
  </div>
</article>
