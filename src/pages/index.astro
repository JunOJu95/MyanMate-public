---
import Base from '../layouts/Base.astro';
import HomeServicePreview from '../components/HomeServicePreview.astro';
import Icon from '../components/Icon.astro';
import LocalizedText from '../components/LocalizedText.astro';
import PostCard from '../components/PostCard.astro';
import SocialDmPanel from '../components/SocialDmPanel.astro';
import T from '../components/T.astro';
import TikTokTrust from '../components/TikTokTrust.astro';
import { services } from '../data/services';
import { defaultLang, t } from '../i18n/ui';
import {
  getLatestPosts,
  getServiceContents,
  getServiceOffers,
  type LocalizedText as LocalizedTextValue,
} from '../lib/content';

const [serviceContent, serviceOffers, latestPosts] = await Promise.all([
  getServiceContents(),
  getServiceOffers(),
  getLatestPosts(4),
]);
const informationLinks: Array<{
  id: string;
  titleKey?: string;
  title?: LocalizedTextValue;
  summaryKey?: string;
  summary?: LocalizedTextValue;
  href: string;
  icon: string;
  event: string;
}> = [
  {
    id: 'visa',
    titleKey: 'home.entry.visa',
    summaryKey: 'infoHub.visa.summary',
    href: '/guides/visa',
    icon: 'visa',
    event: 'home_information_visa',
  },
  {
    id: 'resume',
    title: serviceContent.resume.title,
    summary: serviceContent.resume.description,
    href: '/guides/resume',
    icon: 'resumeSvc',
    event: 'home_information_resume',
  },
  {
    id: 'housing',
    title: serviceContent.housing.title,
    summary: serviceContent.housing.description,
    href: '/guides/housing',
    icon: 'housing',
    event: 'home_information_housing',
  },
  {
    id: 'all',
    titleKey: 'home.information.all.title',
    summaryKey: 'home.information.all.summary',
    href: '/blog',
    icon: 'topics',
    event: 'home_information_all',
  },
];
const processSteps = [
  { title: 'home.process.step1.title', body: 'home.process.step1.body' },
  { title: 'home.process.step2.title', body: 'home.process.step2.body' },
  { title: 'home.process.step3.title', body: 'home.process.step3.body' },
];
---
<Base
  title=""
  active="home"
  description={t('home.hero.sub', defaultLang)}
>
  <div class="wrap home-wrap">
    <!-- hero -->
    <section class="sec home-hero" data-reveal="hero">
      <img class="hero-media" src="/images/brand/guidance-desk.jpg" alt="" loading="eager" decoding="async" aria-hidden="true" />
      <div class="hero-copy" data-hero-sequence>
        <T k="home.hero.kicker" tag="p" class="eyebrow" />
        <T k="home.hero.headline" tag="h1" class="h-hero" />
        <T k="home.hero.sub" tag="p" class="t-sub" />
      </div>
      <div class="scene-panel" aria-hidden="true">
        <span class="desk-label">MYANMATE / SEOUL</span>
        <span data-i18n="home.hero.visual.title">{t('home.hero.visual.title', defaultLang)}</span>
      </div>
    </section>

    <section class="trust-strip" aria-label={t('home.trust.slogan', defaultLang)} data-i18n-aria="home.trust.slogan" data-reveal="section">
      <T k="home.trust.slogan" tag="p" class="trust-slogan" />
    </section>

    <!-- newest long-form information -->
    <section
      class="sec home-section home-latest-band"
      aria-label={t('home.latest.title', defaultLang)}
      data-i18n-aria="home.latest.title"
      data-reveal="section"
    >
      <div class="home-editorial-head">
        <div>
          <T k="home.latest.eyebrow" tag="p" class="home-section-eyebrow" />
          <T k="home.latest.title" tag="h2" class="home-display-title" />
        </div>
        <T k="home.latest.lead" tag="p" class="home-section-lead" />
      </div>
      {latestPosts.length > 0 ? (
        <div class:list={['home-latest-layout', { 'is-single': latestPosts.length === 1 }]}>
          <div class="home-latest-feature">
            <PostCard post={latestPosts[0]} variant="featured" headingLevel={3} />
          </div>
          {latestPosts.length > 1 && (
            <div class="home-latest-list" data-stagger>
              {latestPosts.slice(1).map((post) => <PostCard post={post} variant="row" headingLevel={3} />)}
            </div>
          )}
        </div>
      ) : (
        <p class="home-latest-empty"><T k="blog.empty" /></p>
      )}
      <a class="home-text-link" href="/blog" data-event="home_blog_all">
        <T k="blog.viewAll" />
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- structured information index -->
    <section
      class="sec home-section home-information-band"
      aria-label={t('home.information.title', defaultLang)}
      data-i18n-aria="home.information.title"
      data-reveal="section"
    >
      <div class="home-editorial-head">
        <div>
          <T k="home.information.eyebrow" tag="p" class="home-section-eyebrow" />
          <T k="home.information.title" tag="h2" class="home-display-title" />
        </div>
        <T k="home.information.lead" tag="p" class="home-section-lead" />
      </div>
      <div class="home-information-index" data-stagger>
        {informationLinks.map((entry, index) => (
          <a
            class="home-information-row"
            href={entry.href}
            data-event={entry.event}
            data-information={entry.id}
            data-source="home-information"
          >
            <span class="home-information-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="home-information-icon" aria-hidden="true"><Icon name={entry.icon} size={21} /></span>
            <span class="home-information-copy">
              {entry.title
                ? <LocalizedText value={entry.title} tag="h3" class="home-information-title" />
                : <T k={entry.titleKey!} tag="h3" class="home-information-title" />}
              {entry.summary
                ? <LocalizedText value={entry.summary} tag="span" class="home-information-summary" />
                : <T k={entry.summaryKey!} tag="span" class="home-information-summary" />}
            </span>
            <span class="home-information-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- active guidance services -->
    <section
      class="sec home-section home-services-band"
      aria-label={t('home.services.preview.title', defaultLang)}
      data-i18n-aria="home.services.preview.title"
      data-reveal="section"
    >
      <div class="home-services-layout">
        <div class="home-services-intro">
          <T k="home.services.preview.eyebrow" tag="p" class="home-section-eyebrow" />
          <T k="home.services.preview.title" tag="h2" class="home-display-title" />
          <T k="home.services.preview.lead" tag="p" class="home-section-lead" />
          <a class="home-text-link" href="/services" data-event="home_services_all">
            <T k="home.services.preview.viewAll" />
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="home-service-list" data-stagger>
          {services.map((service, index) => (
            <HomeServicePreview service={service} offer={serviceOffers[service.id]} index={index} />
          ))}
        </div>
      </div>
    </section>

    <!-- information-to-DM journey -->
    <section class="sec home-section home-journey-band" data-reveal="section">
      <div class="home-journey-layout">
        <div class="home-journey-copy">
          <T k="home.journey.eyebrow" tag="p" class="home-section-eyebrow" />
          <T k="home.process.title" tag="h2" class="home-display-title" />
          <T k="home.journey.lead" tag="p" class="home-section-lead" />
          <div class="home-process-list" data-reveal="process" data-stagger>
            {processSteps.map((step, index) => (
              <div class="home-process-step">
                <span class="home-process-number" aria-hidden="true">{index + 1}</span>
                <div>
                  <p class="card-title" data-i18n={step.title}>{t(step.title, defaultLang)}</p>
                  <p class="t-body" data-i18n={step.body}>{t(step.body, defaultLang)}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="home-journey-dm" data-reveal="cta">
          <SocialDmPanel context="general" service="general" source="home-journey" id="dm" />
        </div>
      </div>
    </section>

    <!-- short-form information -->
    <section class="sec home-section community-band" data-reveal="section">
      <TikTokTrust />
    </section>

    <!-- compact story teaser -->
    <section class="sec home-section home-about-compact" data-reveal="section">
      <div>
        <T k="home.about.eyebrow" tag="p" class="home-section-eyebrow" />
        <T k="home.about.title" tag="h2" class="home-display-title" />
      </div>
      <div class="home-about-copy">
        <T k="home.about.blurb" tag="p" class="home-section-lead" />
        <a class="home-text-link" href="/about" data-event="about:story">
          <T k="home.about.cta" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Base>
