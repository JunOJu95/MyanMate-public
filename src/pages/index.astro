---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import Teachers from '../components/Teachers.astro';
import PostCard from '../components/PostCard.astro';
import { getLatestPosts } from '../lib/content';
import { t } from '../i18n/ui';
import { courseIds } from '../config/courses';
import '../styles/learning.css';
const posts = await getLatestPosts(3);
---
<Base title={t('learn.nav')} description={t('learn.lead')} active="home">
<div class="wrap learning">
  <section class="learn-hero">
    <div><T k="learn.kicker" tag="p" class="learn-eyebrow" /><T k="learn.title" tag="h1" /><T k="learn.lead" tag="p" class="learn-lead" />
      <div class="learn-actions"><a href="/apply" class="btn pri" data-event="class_apply_home"><T k="learn.apply" /> <span aria-hidden="true">↗</span></a></div>
      <T k="learn.now" tag="p" class="learn-status" />
    </div>
    <div class="learn-notebook"><T k="learn.hello" tag="p" class="learn-eyebrow" /><div class="notebook-greeting"><T k="learn.helloWord" tag="p" class="learn-word" /><svg class="notebook-underline" viewBox="0 0 280 18" fill="none" aria-hidden="true"><path d="M4 11C68 3 166 3 274 8M35 16C104 10 180 10 239 13" /></svg><svg class="notebook-spark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2v9m0 10v9M2 16h9m10 0h9M6 6l6 6m8 8 6 6" /></svg></div><T k="learn.helloMeaning" tag="p" class="notebook-meaning" /><div class="learn-notebook-bottom"><span aria-hidden="true">가 · 나 · 다</span><span aria-hidden="true">01 / MYANMATE</span></div></div>
  </section>
  <section class="learn-section" id="courses"><T k="learn.courses" tag="h2" /><T k="learn.courseLead" tag="p" class="learn-lead" />
    <div class="course-list">{courseIds.map((course,i)=>(<a class="course-row" href={'/courses/'+course} data-event={'class_view_'+course}><span class="course-number" aria-hidden="true">0{i+1}</span><div><div class="course-row-meta"><T k={'course.'+course+'.audience'} /><span aria-hidden="true">·</span><T k={'course.'+course+'.duration'} /></div><T k={'learn.'+course} tag="h3" /><T k={'learn.'+course+'Body'} tag="p" /></div><span class="btn"><T k="course.viewDetails" /><span aria-hidden="true">↗</span></span></a>))}</div>
  </section>
  <Teachers />
  <section class="learn-section"><T k="learn.steps" tag="h2" /><div class="learn-steps">{[1,2,3].map(n=>(<article><span class="course-number" aria-hidden="true">0{n}</span><T k={'learn.step'+n} tag="h3" /><T k={'learn.step'+n+'Body'} tag="p" /></article>))}</div></section>
  <section class="learn-section"><T k="learn.faq" tag="h2" />{[1,2,3].map(n=>(<details class="learn-faq"><summary><T k={'learn.faq'+n} /></summary><T k={'learn.faq'+n+'Body'} tag="p" /></details>))}</section>
  <section class="learn-banner"><T k="learn.blogCta" tag="h2" /><a class="btn pri" href="/apply" data-event="class_apply_bottom"><T k="learn.apply" /></a></section>
  <section class="learn-section"><div class="learn-heading"><T k="learn.blog" tag="h2" /><a href="/blog" class="btn ghost"><T k="blog.viewAll" /></a></div><div class="learn-posts">{posts.map(post=><PostCard post={post} variant="home" headingLevel={3} />)}</div></section>
</div>
</Base>

<script>
  const notebook = document.querySelector('.learn-notebook');
  if (notebook && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) {
        notebook.classList.add('notebook-visible');
        observer.disconnect();
      }
    }, { threshold: 0.35 });
    observer.observe(notebook);
  }

  if ('IntersectionObserver' in window) {
    const motionObserver = new IntersectionObserver((entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('motion-visible');
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });

    document.querySelectorAll('.course-list, .learn-steps').forEach((section) => {
      motionObserver.observe(section);
    });
  }
</script>
