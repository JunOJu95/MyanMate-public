---
import BlogIndexPage from '../../components/BlogIndexPage.astro';
import { getPosts } from '../../lib/content';
import { t } from '../../i18n/ui';

const posts = await getPosts();
---
<BlogIndexPage
  posts={posts}
  activeCategory="all"
  title={t('blog.seo.title', 'en')}
  description={t('blog.seo.description', 'en')}
  canonicalPath="/blog"
/>
