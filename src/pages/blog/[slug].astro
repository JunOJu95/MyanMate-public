---
import Base from '../../layouts/Base.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import Icon from '../../components/Icon.astro';
import JsonLd from '../../components/JsonLd.astro';
import T from '../../components/T.astro';
import { getPosts, getPost } from '../../lib/content';
import { defaultLang, t } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const data = await getPost(slug!);
if (!data) return Astro.redirect('/blog');

const { meta, bodyHtml } = data;
const date = meta.publishedDate ?? '';
const reviewed = meta.lastReviewed ?? '';
const categoryKey = 'blog.filter.' + meta.category;
const site = Astro.site;
const canonicalUrl = site ? new URL(`/blog/${meta.slug}`, site).href : `/blog/${meta.slug}`;
const blogUrl = site ? new URL('/blog', site).href : '/blog';
const imageUrl = meta.cover && site ? new URL(meta.cover, site).href : meta.cover;
const organizationId = site ? new URL('/#organization', site).href : 'https://www.myanmate.com/#organization';
const websiteId = site ? new URL('/#website', site).href : 'https://www.myanmate.com/#website';

function plainText(html: string): string {
  return html
    .replace(/<[^>]+>/g, ' ')
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();
}

function extractFaqItems(html: string): Array<{ question: string; answer: string }> {
  const faqRe = /<details class="blog-faq-item">[\s\S]*?<span class="blog-faq-question">([\s\S]*?)<\/span>[\s\S]*?<div class="blog-faq-answer">([\s\S]*?)<\/div>\s*<\/details>/g;
  return Array.from(html.matchAll(faqRe))
    .map((match) => ({
      question: plainText(match[1]),
      answer: plainText(match[2]),
    }))
    .filter((item) => item.question && item.answer);
}

const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  headline: meta.headline,
  name: meta.headline,
  url: canonicalUrl,
  description: meta.excerpt,
  image: imageUrl ? [imageUrl] : undefined,
  thumbnailUrl: imageUrl || undefined,
  inLanguage: meta.lang,
  articleSection: t(categoryKey, defaultLang),
  datePublished: date || undefined,
  dateModified: reviewed || date || undefined,
  author: {
    '@type': 'Organization',
    name: meta.author || 'MyanMate',
    '@id': organizationId,
  },
  publisher: { '@id': organizationId },
  isPartOf: { '@id': websiteId },
  isAccessibleForFree: true,
};
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: site ? new URL('/', site).href : '/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t('blog.title', defaultLang),
      item: blogUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: meta.headline,
      item: canonicalUrl,
    },
  ],
};
const faqItems = extractFaqItems(bodyHtml);
const faqStructuredData = faqItems.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---
<Base
  title={meta.headline}
  active="blog"
  description={meta.excerpt}
  canonicalPath={'/blog/' + meta.slug}
  image={meta.cover ?? undefined}
  ogType="article"
  publishedTime={date || undefined}
  modifiedTime={reviewed || date || undefined}
  articleSection={t(categoryKey, 'en')}
  articleAuthor={meta.author || 'MyanMate'}
>
  <JsonLd slot="head" data={articleStructuredData} />
  <JsonLd slot="head" data={breadcrumbStructuredData} />
  {faqStructuredData && <JsonLd slot="head" data={faqStructuredData} />}

  <div class="wrap blog-detail-wrap">
    <article class="blog-article">
      <a class="blog-back" href="/blog">
        <span aria-hidden="true">←</span>
        <T k="blog.back" />
      </a>

      <header class="blog-article-head">
        <div class="blog-article-labels">
          <span class="blog-card-category" data-i18n={categoryKey}>{t(categoryKey, defaultLang)}</span>
          {meta.draft && <T k="blog.draft" tag="span" class="blog-draft-badge" />}
        </div>
        <h1 class="blog-article-title blog-authored" lang={meta.lang}>{meta.headline}</h1>
        <p class="blog-article-meta">
          {date && <time datetime={date}>{date}</time>}
          {date && meta.author && <span aria-hidden="true">·</span>}
          {meta.author && <span lang={meta.lang}>{meta.author}</span>}
        </p>
        {reviewed && (
          <p class="blog-article-reviewed">
            <T k="content.lastReviewed" />
            <span aria-hidden="true">:</span>
            <time datetime={reviewed}>{reviewed}</time>
          </p>
        )}
      </header>

      {meta.cover && (
        <figure class="blog-article-cover" lang={meta.lang}>
          <img
            src={meta.cover}
            alt={meta.coverAlt}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
      )}

      <div class="post-prose blog-authored" lang={meta.lang} set:html={bodyHtml}></div>

      <div class="blog-disclaimer">
        <span class="blog-disclaimer-icon" aria-hidden="true"><Icon name="shield" size={30} /></span>
        <Disclaimer k="content.disclaimer" />
      </div>
    </article>
  </div>

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    document.querySelectorAll('details.blog-faq-item').forEach((item) => {
      if (!(item instanceof HTMLDetailsElement) || item.dataset.faqAnimated) return;

      const summary = item.querySelector('summary');
      const answer = item.querySelector('.blog-faq-answer');
      if (!summary || !(answer instanceof HTMLElement)) return;

      item.dataset.faqAnimated = 'true';

      summary.addEventListener('click', (event) => {
        if (reducedMotion.matches) return;

        event.preventDefault();

        const startHeight = item.offsetHeight;
        item.style.overflow = 'hidden';
        item.style.height = `${startHeight}px`;

        if (item.open) {
          const endHeight = summary.offsetHeight;
          item.classList.add('is-closing');
          item.classList.remove('is-opening');

          requestAnimationFrame(() => {
            item.style.height = `${endHeight}px`;
          });

          item.addEventListener('transitionend', function finish(event) {
            if (event.propertyName !== 'height') return;
            item.removeEventListener('transitionend', finish);
            item.open = false;
            item.classList.remove('is-closing');
            item.style.height = '';
            item.style.overflow = '';
          });
        } else {
          item.open = true;
          item.classList.add('is-opening');
          item.classList.remove('is-closing');

          const endHeight = summary.offsetHeight + answer.offsetHeight;

          requestAnimationFrame(() => {
            item.style.height = `${endHeight}px`;
          });

          item.addEventListener('transitionend', function finish(event) {
            if (event.propertyName !== 'height') return;
            item.removeEventListener('transitionend', finish);
            item.classList.remove('is-opening');
            item.style.height = '';
            item.style.overflow = '';
          });
        }
      });
    });
  </script>
</Base>
