---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import T from '../../components/T.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import SocialDmPanel from '../../components/SocialDmPanel.astro';
import { availableServices } from '../../data/services';
import { getServiceOffers } from '../../lib/content';
import { defaultLang, t } from '../../i18n/ui';

const showServices = false;
const serviceOffers = showServices ? await getServiceOffers() : null;
---

<Base
  title={showServices ? t('home.services.title', defaultLang) : t('services.coming.title', defaultLang)}
  active="services"
  description={showServices ? undefined : t('services.coming.description', defaultLang)}
  canonicalPath="/services"
>
  <div class="wrap">
    {showServices ? (
      <>
        <section class="sec page-hero services-hero" data-reveal="page-hero">
          <h1 class="lead-title"><T k="home.services.title" /></h1>
          <!-- compliance up front: what we do / don't -->
          <T k="svcDetail.dont.body" tag="p" class="t-body" />
        </section>
        <section class="sec page-content" data-reveal="section">
          <div class="grid-services services-page-grid" data-reveal="stagger" data-stagger>
            {availableServices.map((service) => <ServiceCard service={service} offer={serviceOffers![service.id]} />)}
          </div>
        </section>
        <section class="sec visa-hub-dm" data-reveal="cta">
          <SocialDmPanel context="general" source="services-hub" id="dm" compact />
        </section>
      </>
    ) : (
      <section class="sec services-coming-soon" data-reveal="page-hero" aria-labelledby="services-coming-soon-title">
        <div class="services-coming-soon-card">
          <T k="services.coming.kicker" tag="span" class="services-coming-soon-kicker" />
          <h1
            id="services-coming-soon-title"
            class="services-coming-soon-title"
            data-i18n="services.coming.title"
          >
            {t('services.coming.title', defaultLang)}
          </h1>
          <T k="services.coming.description" tag="p" class="services-coming-soon-copy" />
          <div class="services-coming-soon-actions">
            <a class="btn pri services-coming-soon-primary" href="/guides" data-event="services_coming_soon_guides">
              <Icon name="list" size={17} />
              <T k="services.coming.guides" />
            </a>
            <a class="services-coming-soon-contact" href="/contact#dm" data-event="services_coming_soon_contact">
              <T k="services.coming.contact" />
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )}
  </div>
</Base>
