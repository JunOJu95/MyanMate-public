---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getReviews } from '../lib/content';
import { t } from '../i18n/ui';
import '../styles/learning.css';
import '../styles/reviews.css';

const reviews = await getReviews();
---
<Base title={t('reviews.title')} active="reviews" description={t('reviews.subtitle')}>
  <div class="wrap learning reviews-page">
    <section class="reviews-hero">
      <T k="learn.kicker" tag="p" class="learn-eyebrow" />
      <T k="reviews.title" tag="h1" />
      <T k="reviews.subtitle" tag="p" class="learn-lead" />
      <div class="reviews-principle"><span aria-hidden="true">✓</span><T k="reviews.principle" tag="p" /></div>
    </section>

    <section class="reviews-section" aria-label={t('reviews.title')} data-i18n-aria="reviews.title">
      {reviews.length > 0 ? (
        <div class="reviews-grid">
          {reviews.map((review) => <ReviewCard review={review} />)}
        </div>
      ) : (
        <div class="reviews-empty">
          <span class="reviews-empty-mark" aria-hidden="true">“</span>
          <div>
            <T k="reviews.empty.kicker" tag="p" class="reviews-eyebrow" />
            <T k="reviews.empty.title" tag="h2" />
            <T k="reviews.empty.body" tag="p" />
          </div>
        </div>
      )}
    </section>

    <section class="reviews-next">
      <div>
        <T k="reviews.next.title" tag="h2" />
        <T k="reviews.next.body" tag="p" />
      </div>
      <a class="btn pri" href="/apply"><T k="learn.apply" /></a>
    </section>
  </div>
</Base>
