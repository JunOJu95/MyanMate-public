---
import Base from '../../layouts/Base.astro';
import T from '../../components/T.astro';
import GuideCard from '../../components/GuideCard.astro';
import SocialDmPanel from '../../components/SocialDmPanel.astro';
import { getGuides } from '../../lib/content';
import { defaultLang, t } from '../../i18n/ui';

const allGuides = await getGuides();
const visaSubtypeDetailSlugs = new Set([
  'd2-1-associate-degree',
  'd2-2-bachelor-degree',
  'd2-3-master-degree',
  'd2-4-doctoral-degree',
  'd4-1-korean-language-training',
  'e7-1-professional-worker',
  'e7-4-skilled-worker',
  'e7-m-manufacturing-skilled-worker',
  'f2-7-points-based-residence',
  'f2-99-long-term-resident',
]);
const guides = allGuides.filter((guide) => guide.category === 'visa' && !visaSubtypeDetailSlugs.has(guide.slug));
const visaPurposes = [
  { id: 'all', labelKey: 'visaPurpose.all' },
  { id: 'study', labelKey: 'visaPurpose.study' },
  { id: 'work', labelKey: 'visaPurpose.work' },
  { id: 'residence', labelKey: 'visaPurpose.residence' },
  { id: 'other', labelKey: 'visaPurpose.other' },
] as const;
type VisaPurpose = (typeof visaPurposes)[number]['id'];
const visaPurposeBySlug: Record<string, Exclude<VisaPurpose, 'all'>> = {
  'd2-student-visa': 'study',
  'd4-language-visa': 'study',
  'd10-jobseeking': 'work',
  'e9-employment': 'work',
  'e7-employment': 'work',
  'f2-resident': 'residence',
  'f6-marriage': 'residence',
  'g1-miscellaneous': 'other',
};
const visaPurpose = (slug: string): Exclude<VisaPurpose, 'all'> => visaPurposeBySlug[slug] ?? 'other';
---

<Base title={t('guides.title', defaultLang)} active="guides" description={t('guides.intro', defaultLang)}>
  <div class="wrap visa-hub-page">
    <section class="sec page-hero visa-hub-hero" data-reveal="page-hero">
      <div class="guide-detail-hero-head visa-hub-hero-head">
        <div class="guide-detail-hero-copy">
          <T k="guides.eyebrow" tag="p" class="visa-hub-eyebrow" />
          <h1 class="lead-title"><T k="guides.title" /></h1>
          <T k="guides.intro" tag="p" class="t-sub" />
        </div>
      </div>
    </section>

    <section class="sec visa-hub-content" data-reveal="section">
      <div class="visa-purpose-filter-shell" data-visa-purpose-hub>
        <div
          class="visa-purpose-filter"
          role="group"
          aria-label={t('visaPurpose.label', defaultLang)}
          data-i18n-aria="visaPurpose.label"
        >
          {visaPurposes.map((purpose) => (
            <button
              class:list={['visa-purpose-button', { on: purpose.id === 'all' }]}
              type="button"
              data-visa-purpose-filter={purpose.id}
              aria-pressed={purpose.id === 'all' ? 'true' : 'false'}
              data-i18n={purpose.labelKey}
            >
              {t(purpose.labelKey, defaultLang)}
            </button>
          ))}
        </div>

        <p class="visa-purpose-note">
          <T k="visaPurpose.note" />
        </p>
      </div>

      <div class="visa-guide-grid visa-hub-grid" data-reveal="stagger" data-stagger>
        {guides.map((guide) => (
          <div class="visa-guide-item" data-visa-purpose={visaPurpose(guide.slug)}>
            <GuideCard guide={guide} variant="featured" eventSource="guides" />
          </div>
        ))}
      </div>
      <div class="empty-state visa-purpose-empty" data-visa-purpose-empty hidden>
        <p class="card-title" data-i18n="visaPurpose.empty.title">{t('visaPurpose.empty.title', defaultLang)}</p>
        <p class="t-body" data-i18n="visaPurpose.empty.body">{t('visaPurpose.empty.body', defaultLang)}</p>
      </div>
      {guides.length === 0 && (
        <div class="empty-state">
          <p class="card-title" data-i18n="guides.empty.title">{t('guides.empty.title', defaultLang)}</p>
          <p class="t-body" data-i18n="guides.empty.body">{t('guides.empty.body', defaultLang)}</p>
          <div class="empty-actions">
            <a class="btn pri" href="/contact#dm" data-i18n="dm.cta" data-event="guides_empty_contact">{t('dm.cta', defaultLang)}</a>
          </div>
        </div>
      )}
    </section>
    {guides.length > 0 && (
      <section class="sec visa-hub-dm" data-reveal="cta">
        <SocialDmPanel
          service="visa"
          context="visa"
          source="guides-visa"
          id="dm"
          compact
        />
      </section>
    )}
  </div>

  <script>
    import '../../scripts/visa-purpose-filter.ts';
  </script>
</Base>
