---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import LocalizedText from '../../components/LocalizedText.astro';
import SocialDmPanel from '../../components/SocialDmPanel.astro';
import T from '../../components/T.astro';
import { defaultLang, t } from '../../i18n/ui';
import { guideCategories } from '../../data/guide-categories';
---

<Base title={t('infoHub.title', defaultLang)} active="guides" description={t('infoHub.intro', defaultLang)}>
  <div class="wrap guide-library-page">
    <section class="sec guide-library-hero" data-reveal="page-hero">
      <T k="infoHub.eyebrow" tag="p" class="guide-library-eyebrow" />
      <h1 class="guide-library-title"><T k="infoHub.title" /></h1>
      <T k="infoHub.intro" tag="p" class="guide-library-intro" />
    </section>

    <section class="guide-category-nav-section" data-reveal="section">
      <div class="guide-category-nav-head">
        <T k="infoHub.choose" tag="h2" class="sec-title" />
        <T k="infoHub.chooseNote" tag="p" class="t-body" />
      </div>
      <div class="guide-category-card-grid" role="group" aria-label={t('infoHub.choose', defaultLang)}>
        {guideCategories.map((category) => (
          <a class="guide-category-card" href={category.href} style={`--guide-card-image:url('${category.image}')`}>
            <span class="guide-category-card-top">
              <span class="guide-category-card-icon"><Icon name={category.icon} size={20} /></span>
              <span class="guide-category-card-arrow" aria-hidden="true"></span>
            </span>
            <span class="guide-category-card-copy">
              <LocalizedText value={category.title} tag="span" class="guide-category-card-title" />
              <LocalizedText value={category.focus[0]} tag="span" class="guide-category-card-summary" />
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="sec visa-hub-dm" data-reveal="cta">
      <SocialDmPanel context="general" source="guides-hub" id="dm" compact />
    </section>
  </div>
</Base>
