---
import ServiceInformationPage from '../../components/ServiceInformationPage.astro';
import { getServiceContent } from '../../lib/content';

const content = await getServiceContent('student-part-time-work-permit');

if (!content) {
  throw new Error('Student part-time work permit information content is missing.');
}
---

<ServiceInformationPage
  topicId="student-part-time-work-permit"
  icon="jobs"
  content={content}
  backHref="/guides/work"
  backLabel={{
    en: 'Back to work guides',
    ko: '일·취업 가이드로 돌아가기',
    my: 'အလုပ် လမ်းညွှန်များသို့ ပြန်သွားရန်',
  }}
/>
