---
import ServiceInformationPage from '../../components/ServiceInformationPage.astro';
import { serviceById } from '../../data/services';
import { getServiceContent } from '../../lib/content';

const service = serviceById('housing');
const content = await getServiceContent('housing');

if (!service || !content) {
  throw new Error('Housing information content is missing.');
}
---

<ServiceInformationPage
  service={service}
  content={content}
  backHref="/guides/daily-life"
  backLabel={{
    en: 'Back to daily-life guides',
    ko: '생활 가이드로 돌아가기',
    my: 'နေ့စဉ်ဘဝ လမ်းညွှန်များသို့ ပြန်သွားရန်',
  }}
/>
