---
import ServiceInformationPage from '../../components/ServiceInformationPage.astro';
import { getServiceContent } from '../../lib/content';

const content = await getServiceContent('address-change-after-moving');

if (!content) {
  throw new Error('Address change after moving information content is missing.');
}
---

<ServiceInformationPage
  topicId="address-change-after-moving"
  icon="housing"
  content={content}
  backHref="/guides/daily-life"
  backLabel={{
    en: 'Back to daily-life guides',
    ko: '생활 가이드로 돌아가기',
    my: 'နေ့စဉ်ဘဝ လမ်းညွှန်များသို့ ပြန်သွားရန်',
  }}
/>
