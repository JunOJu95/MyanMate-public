---
import ServiceInformationPage from '../../components/ServiceInformationPage.astro';
import { getServiceContent } from '../../lib/content';

const content = await getServiceContent('find-part-time-jobs-safely');

if (!content) {
  throw new Error('Safe part-time job search information content is missing.');
}
---

<ServiceInformationPage
  topicId="find-part-time-jobs-safely"
  icon="search"
  content={content}
  backHref="/guides/work"
  backLabel={{
    en: 'Back to work guides',
    ko: '일·취업 가이드로 돌아가기',
    my: 'အလုပ် လမ်းညွှန်များသို့ ပြန်သွားရန်',
  }}
/>
