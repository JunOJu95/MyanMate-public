---
import ServiceInformationPage from '../../components/ServiceInformationPage.astro';
import { getServiceContent } from '../../lib/content';

const content = await getServiceContent('employment-contract-basics');

if (!content) {
  throw new Error('Employment contract basics information content is missing.');
}
---

<ServiceInformationPage
  topicId="employment-contract-basics"
  icon="doc"
  content={content}
  backHref="/guides/work"
  backLabel={{
    en: 'Back to work guides',
    ko: '일·취업 가이드로 돌아가기',
    my: 'အလုပ် လမ်းညွှန်များသို့ ပြန်သွားရန်',
  }}
/>
